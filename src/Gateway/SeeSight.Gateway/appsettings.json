{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "IdentityService": {
    "BaseUrl": "http://identity:8080",
    "JwksRefreshIntervalMinutes": 5
  },
  "Gateway": {
    "AuthCookie": {
      "Name": "seesight_access_token",
      "RefreshTokenName": "seesight_refresh_token"
    },
    "AllowedOrigins": [],
    "RateLimit": {
      "RedisConnectionString": "redis:6379",
      "RequestsPerWindow": 10,
      "WindowSeconds": 60
    }
  },
  "Observability": {
    "OtlpEndpoint": "http://otel-collector:4317"
  }
}
